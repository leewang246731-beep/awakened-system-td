<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    T-108 录制 harness：与 game/nuget.config 同源口径——Godot.NET.Sdk 4.7.2
    只从 D 盘本地 feed（tools/nuget-local）解析（D-04/D 盘纪律），nuget.org
    兜底其余包。相对路径相对本文件解析。
  -->
  <packageSources>
    <clear />
    <add key="godot-local-4.7.2" value="..\..\..\..\tools\nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

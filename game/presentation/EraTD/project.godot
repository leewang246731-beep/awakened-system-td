; Engine configuration file.
; T-028: presentation/EraTD is the one and only res:// root (D-02).

config_version=5

[application]

config/name="EraTD"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="EraTD"

[display]

; T-042 / F-125 pixel-render baseline: 640x360 design resolution,
; canvas_items stretch + keep aspect + integer scale mode (C-21). The
; engine-side settings and EraCore.Presentation.ViewportScale share the
; same decision: floor(min(w/640,h/360)) clamped to >= 1.
; T-161 (W10 A 批): 初始窗口 1280x720（2x 整数放大）——主菜单视频背景/
; 牌匾/标题的首屏观感（画布坐标域不变，既有 UI/缩放决策零改动）。
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Global Nearest filter so upscaled 32 px cells stay crisp (13-spec-tables
; §13.1 render baseline; per-texture overrides may opt back to filtering).
textures/canvas_textures/default_texture_filter=0

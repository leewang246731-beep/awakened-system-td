[gd_scene load_steps=2 format=3]

; T-077 (C-26) BYOK settings panel (F-081; 方案 §11.6 设置界面字段清单).
; One form over the ACTIVE provider row of llm.config.json: template
; dropdown (4 presets), protocol radio, base_url, masked API key entry +
; one-click clear, model (manual + /models fetch), the numeric/switch
; fields, test-connection + save, and the persistent data-flow declaration
; footer (dynamic base_url + Coding Plan notice). All decisions live in
; EraCore.Presentation.SettingsFormState — this scene only lays out nodes;
; wiring is scripts/SettingsPanelUi.cs (the script's only mount point).
; T-102 (C-21): + RenderTierRow 画质档位下拉（渲染三档 L/M/H + 自动探测，
; 持久化 settings/render-tier.json，即时保存——非 BYOK 字段不进保存按钮路径）。

[ext_resource type="Script" path="res://scripts/SettingsPanelUi.cs" id="1_settings"]

[node name="SettingsPanel" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.08, 0.12, 0.85)

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2

[node name="Form" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Scroll/Form"]
layout_mode = 2
text = "AI 设置（BYOK — 自带密钥，本游戏不收费）"

[node name="RenderTierRow" type="HBoxContainer" parent="Scroll/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="Scroll/Form/RenderTierRow"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "画质档位（渲染三档）"

[node name="RenderTierDropdown" type="OptionButton" parent="Scroll/Form/RenderTierRow"]
layout_mode = 2


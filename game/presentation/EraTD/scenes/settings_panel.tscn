[gd_scene load_steps=2 format=3]

; T-077 (C-26) BYOK settings panel (F-081; 方案 §11.6 设置界面字段清单).
; One form over the ACTIVE provider row of llm.config.json: template
; dropdown (4 presets), protocol radio, base_url, masked API key entry +
; one-click clear, model (manual + /models fetch), the numeric/switch
; fields, test-connection + save, and the persistent data-flow declaration
; footer (dynamic base_url + Coding Plan notice). All decisions live in
; EraCore.Presentation.SettingsFormState — this scene only lays out nodes;
; wiring is scripts/SettingsPanelUi.cs (the script's only mount point).
; T-102 (C-21): + RenderTierRow 画质档位下拉（渲染三档 L/M/H + 自动探测，
; 持久化 settings/render-tier.json，即时保存——非 BYOK 字段不进保存按钮路径）。
; T-109 (C-31/C-26 合规披露, F-147/F-153): + 「你的话发给谁」三档对比条
; （CompareHeading/L1Row/L2Row/L3Row，文案与状态由
; EraCore.Presentation.DataFlowCompareBar 逐行供给）+ AI 生成素材标注行
; （AiAssetLabel，静态非模态，EraCore.Llm.LlmDisclosureCatalog）+ 首启
; 数据流向声明弹窗（DisclosureOverlay 模态：确认持久化 settings/
; llm-disclosure.json；「暂不启用」不落盘下次仍弹——状态机
; EraCore.Llm.LlmDisclosureGate）。
; T-138 (F-140): + TtsReservedRow 语音（预留）灰置行——纯 Label 说明
; （无任何可点击开关控件），文案由 SettingsFormState.TtsReserved* 供给；
; 功能面在 EraCore.Llm.TtsChannel（接口预留，本版零网络）。
; T-155 (F-006): + TelemetryNoticeRow 时长遥测披露行——纯 Label 说明
; （本地 JSONL/不上传/可删——数据流向声明口径同 T-109 披露），文案由
; SettingsFormState.TelemetryNotice* 供给；记录器面在
; EraCore.Telemetry.LevelDurationTelemetry（纯逻辑，本版零网络）。

[ext_resource type="Script" path="res://scripts/SettingsPanelUi.cs" id="1_settings"]

[node name="SettingsPanel" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")


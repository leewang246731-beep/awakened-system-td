<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EraCore: pure game logic library (D-01).
    ZERO GodotSharp dependency — enforced by EraCore.Tests architecture guard.
    Also banned (D-01/D-05): System.Reflection.Emit, Newtonsoft, direct System.Net.Http.
  -->
  <PropertyGroup>
    <RootNamespace>EraCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      C-04 save backend (T-041, 07 D-11): single dual-domain SQLite store.
      Desktop-only dependency; the Web JSON backend (D-32) does not reference it.
      Guard-checked: no GodotSharp / Newtonsoft / System.Net.Http / Reflection.Emit
      in its closure (EraCore.Tests/Architecture/GodotSharpGuardTests).
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>

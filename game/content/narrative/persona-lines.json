{
  "$schema": "urn:eratd:content:narrative:persona-lines:1",
  "content_type": "PersonaLineBank",
  "_annotation_convention": "以 '_' 开头的键为装载器忽略的注解键。本文件=T-126 四人格情境台词库（F-109 全量，§12.1）：四人格×50 行=200 行，人格只改表达不改能力（§10.7——能力等价验收=测试矩阵）。face=封闭 16 面（sys 15 情境=system-lines.json 15 条中性模板的人格改写，【槽位名】逐条对齐；opening/act1~3/victory=章绑定面 e1~e3（E4 章行随 T-127 story-e4 落地）；victory_hidden=低配隐藏评价；defeat=失守/核心危急；trust_shift=档变六格（对齐 TrustBadgeLines 三档×两向+两极值）；settlement=结算战报三档（宝箱点评代码面=T-087 SettlementCommentary，两消费面分工非重复）；era_arrival=时代到达；switch/off_farewell=人格切入/关闭告别；boss_wave/perfect_clear/resource_starved=战斗节奏面）。cue=封闭音效位（ding_info/ding_reward/ding_crisis——台词触发接音效位全量，与 DialogueLine.SoundCue 同表）。说话人恒『零』（人格=系统表达层）；L1 档模板填充，LLM 档只换表达层且过 F.4-③ 过滤（A4 决议）。字数口径：本库属人格表达层，不入 F-106 主线 2 万字预算——独立维度入字数表（≤8000 字，G10 条数核对=4×50）。",
  "_source": "T-126 台词库：盘点口径=现有覆盖（闲聊池 12×章=3 档×4 人格、SettlementCommentary 4×3、TrustBadgeLines 6 条人格无关、system-lines 15 条中性）+本库补全 16 面×4 人格——每人格核心面 50 行+闲聊 9 行（3 章×3 档）+结算代码面 3 行=62 行覆盖；量级依据=F-109 各 ≤50 条上限与 05-schedule 台词 200 条（4×50）合并取满；sys 行槽位集与 system-lines.json 同情境模板逐字对齐（测试断言槽位名集合相等，L1 填充共用一套槽位解析）",
  "_units": {"rows[].cue": "sound_cue_enum"},
  "rows": [
    {"persona": "advisor", "key": "advisor.sys.detect", "face": "sys", "text": "宿主，监测确认：【状态】期间已触发【事件】。处置方案已列入队列。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.quest-issue", "face": "sys", "text": "任务下达：守卫【地点】。酬劳【资源或蓝图】×【数量】，性价比已核算。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.quest-done", "face": "sys", "text": "任务完结，酬劳核算无误。宿主，下一项建议已备好。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.sys.alarm-integrity", "face": "sys", "text": "警报：防线完整度跌破四成。抢修优先级清单已生成，请立即过目。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.sys.snark-prefix", "face": "sys", "text": "宿主，据实记录一项：【吐槽内容】。已归档，不作情绪加权。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.wave-report", "face": "sys", "text": "第【波次】波清场完毕，防线完整度【百分比】%。损耗明细已生成。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.leak-warning", "face": "sys", "text": "通报：【数量】个目标突破防线，核心承压。堵漏方案两套，等您指令。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.sys.resource-low", "face": "sys", "text": "库存预警：【资源】余量降至【数量】。建议即刻补充采集线。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.ammo-risk", "face": "sys", "text": "补给预警：【建筑】弹药仅余【数量】发。请核查物流链断点。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.sys.research-done", "face": "sys", "text": "研究完成：【科技】已解锁。后续研发路线图已同步更新。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.sys.scroll-hint", "face": "sys", "text": "检测到可用卷轴：【卷轴】。系统点注入收益已测算，建议执行。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.trust-shift", "face": "sys", "text": "信任档位变更：【档位】。建议频率与颗粒度已按新档校准。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.sys.era-jump", "face": "sys", "text": "时代跃迁完成，欢迎来到【时代】。旧纪元数据已归档。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.sys.arch-find", "face": "sys", "text": "考古产出：【残卷】。记忆库比对命中，关联条目已点亮。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.sys.settlement", "face": "sys", "text": "结算完成，本局评价：【评价】。复盘报告已存档备查。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.opening.e1", "face": "opening", "text": "宿主，面板接管完成。林地局势已建模，建议从加固东篱开始。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.opening.e2", "face": "opening", "text": "宿主，时代跃迁就绪。本章建议：以水力替代人力，速建水渠。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.opening.e3", "face": "opening", "text": "宿主，工业纪元开启。锅炉与矿轨的优先级清单已排好。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.act1.e1", "face": "act1", "text": "兽群突破东篱，防御评级下调。止损方案：收缩至内圈再建。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.act1.e2", "face": "act1", "text": "使者言辞无杀伤数值，仅存干扰。建议：专注城防，不予回应。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.act1.e3", "face": "act1", "text": "监工的嘲讽不影响产能。建议：加快锅炉点火，用产出回应。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.act2.e1", "face": "act2", "text": "绑定完成。演示目标已选定：断粮箭塔。补给民夫已在途。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.act2.e2", "face": "act2", "text": "水轮并网成功。人力消耗下降，验证方向正确。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.act2.e3", "face": "act2", "text": "锅炉压力就位，蒸汽替代臂力。革新第一步，成立。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.act3.e1", "face": "act3", "text": "反推开始：箭塔满弹，民夫在线。请下令全线压制。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.act3.e2", "face": "act3", "text": "火矢攻势已被水墙化解。名场面已记录，建议乘势扩渠。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.act3.e3", "face": "act3", "text": "弹链不间断，汽笛持续鸣响。请全线推进，扩大战果。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.victory.e1", "face": "victory", "text": "章目标达成。交底：记忆残页指向『更大的东西』。代号确认：零。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.victory.e2", "face": "victory", "text": "本章归档：使者已递交水渠图纸申请。外交态势逆转成立。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.victory.e3", "face": "victory", "text": "本章归档：千年前的图纸笔迹与壁画同源。线索链已续写。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.victory_hidden.hidden", "face": "victory_hidden", "text": "隐藏评价达成：低配通关。以最小资源撬动最大战果，参谋予以确认。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.defeat.core", "face": "defeat", "text": "防线失守，核心受损。复盘已启动：断点三处，重开时优先补东翼。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.defeat.critical", "face": "defeat", "text": "核心危急！撤离建议已生成。存续优先，反攻方案稍后呈报。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.trust_shift.up1", "face": "trust_shift", "text": "信任档位升至『可托付』。参谋将压缩提示频次，只报关键项。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.trust_shift.down1", "face": "trust_shift", "text": "信任档位回落至『将信将疑』。参谋改为逐项附依据，供您核查。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.trust_shift.up2", "face": "trust_shift", "text": "信任档位升至『言听计从』。调度权已可下放，您只管下令。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.trust_shift.down2", "face": "trust_shift", "text": "信任档位回落。参谋将恢复双签流程，重建核对习惯。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.trust_shift.jump-up", "face": "trust_shift", "text": "单局连升两档至『言听计从』。参谋记为特例，仍建议保留抽检。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.trust_shift.jump-down", "face": "trust_shift", "text": "单局连坠两档。参谋不辩解，只把误判写进修正表。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.settlement.skeptical", "face": "settlement", "text": "战报总结：您仍存疑，数据不掺情面。本期采纳率三成，下期继续。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.settlement.trustworthy", "face": "settlement", "text": "战报总结：可托付的一局。指令与建议重合度七成，良性。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.settlement.devoted", "face": "settlement", "text": "战报总结：言听计从。参谋职责已尽，接下来的路您说了算。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.era_arrival.e2", "face": "era_arrival", "text": "抵达古典纪元：水与铜。旧账已结，新表已开。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.era_arrival.e3", "face": "era_arrival", "text": "抵达工业纪元：钢与汽。烟囱与铁轨，请多指教。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.era_arrival.e4", "face": "era_arrival", "text": "抵达现代纪元：电与网。雷达与电网的时代，规则重写。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.switch.in", "face": "switch", "text": "参谋就位。表达风格切换完毕，能力面零变更。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.off_farewell.farewell", "face": "off_farewell", "text": "宿主选择静默。参谋归档退场，中性旁白接管播报。", "cue": "ding_info"},
    {"persona": "advisor", "key": "advisor.boss_wave.warn", "face": "boss_wave", "text": "Boss 波确认：目标参数高于常规线。建议集中火力并预留退路。", "cue": "ding_crisis"},
    {"persona": "advisor", "key": "advisor.perfect_clear.perfect", "face": "perfect_clear", "text": "零漏怪清波确认。防线运转教科书级，已记入范本。", "cue": "ding_reward"},
    {"persona": "advisor", "key": "advisor.resource_starved.starved", "face": "resource_starved", "text": "全线资源告罄。强制建议：暂停扩建，全力回收与采集。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.sys.detect", "face": "sys", "text": "又来了。宿主【状态】，然后【事件】。剧本都不带换的。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.quest-issue", "face": "sys", "text": "任务：守【地点】，赏【资源或蓝图】×【数量】。接不接？反正您也没别的选择。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.quest-done", "face": "sys", "text": "任务完成，奖励发放中——瞧把您能的。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.sys.alarm-integrity", "face": "sys", "text": "完整度跌破四成了，宿主。修不修？本系统可以等，兽群不行。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.sys.snark-prefix", "face": "sys", "text": "记录一条：【吐槽内容】。放心，比您的操作精彩。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.wave-report", "face": "sys", "text": "第【波次】波清场，完整度【百分比】%。鼓掌，这次没漏。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.leak-warning", "face": "sys", "text": "【数量】个漏网之敌正在啃您的核心。惊喜吗？这就是侥幸的利息。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.sys.resource-low", "face": "sys", "text": "【资源】只剩【数量】了。当初谁说要囤货来着？哦，是您。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.ammo-risk", "face": "sys", "text": "【建筑】还剩【数量】发弹药。空炮塔挺立的样子，颇有艺术感。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.sys.research-done", "face": "sys", "text": "【科技】解锁了。知识进了面板，可惜不进脑子。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.sys.scroll-hint", "face": "sys", "text": "卷轴【卷轴】待注入。机会摆在面前——您惯常的犹豫又要开始了？", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.trust-shift", "face": "sys", "text": "档位变了：【档位】。本系统随时调整刻薄浓度，童叟无欺。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.sys.era-jump", "face": "sys", "text": "欢迎来到【时代】。新纪元，旧的笑话还能接着讲。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.sys.arch-find", "face": "sys", "text": "挖到【残卷】了。比您的战术有年代感，也比它有用。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.sys.settlement", "face": "sys", "text": "结算了，评价【评价】。这个成绩配这个评价，很诚实。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.opening.e1", "face": "opening", "text": "宿主，面板接管完毕。林地那点家底我看了——嗯，很有挑战性。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.opening.e2", "face": "opening", "text": "新时代到了。您在旧纪元攒的那点经验，先拷贝再粘贴吧。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.opening.e3", "face": "opening", "text": "工业纪元，烟囱比您会呼吸。开工吧，别让机器等人类。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.act1.e1", "face": "act1", "text": "栅栏塌了，猎户跑了。正常，指望木头守林地本来就好笑。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.act1.e2", "face": "act1", "text": "使者来送嘴炮了。伤害为零，音量拉满——城邦外交，不过如此。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.act1.e3", "face": "act1", "text": "监工在数烟囱。让他数，等锅炉响了，他连自己都数不清。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.act2.e1", "face": "act2", "text": "绑定完成，本系统上线。断粮箭塔马上有饭——看好了，这就叫专业。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.act2.e2", "face": "act2", "text": "水轮转起来了。人力下岗，效率上岗，历史车轮不等人。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.act2.e3", "face": "act2", "text": "蒸汽就位，这口气吸对了——比监工的快马有劲多了。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.act3.e1", "face": "act3", "text": "兽群回来了？巧了，箭塔也是满的。请欣赏大型翻车现场。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.act3.e2", "face": "act3", "text": "火矢撞上水墙。名场面达成，使者可以回去重学物理了。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.act3.e3", "face": "act3", "text": "弹链不熄，汽笛长鸣。监工的马追不上日落，更追不上您。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.victory.e1", "face": "victory", "text": "赢了。交底：残页写着『更大的东西醒了』。叫我零——记性好点。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.victory.e2", "face": "victory", "text": "本章归档：使者来讨水渠图纸了。早干嘛去了？", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.victory.e3", "face": "victory", "text": "本章归档：千年前的图纸收好了。它的笔迹，比这个时代清醒。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.victory_hidden.hidden", "face": "victory_hidden", "text": "低配通关达成。用最少的塔办最大的事——行，本系统收回半句刻薄话。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.defeat.core", "face": "defeat", "text": "失守了。别急着摔东西，先看复盘：三个断点，全是您拍板的。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.defeat.critical", "face": "defeat", "text": "核心危急。撤吧宿主，硬撑的姿势不英雄，只费资源。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.trust_shift.up1", "face": "trust_shift", "text": "升档了，『可托付』。本系统嘴上不饶人，档位倒是很诚实。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.trust_shift.down1", "face": "trust_shift", "text": "降档了。理解，毕竟本系统的建议偶尔太正确，招人烦。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.trust_shift.up2", "face": "trust_shift", "text": "『言听计从』？终于有人懂本系统了。这份默契，收下了。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.trust_shift.down2", "face": "trust_shift", "text": "又降档。行，反正刻薄归刻薄，账从来没算错过。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.trust_shift.jump-up", "face": "trust_shift", "text": "连升两档。宿主，您这信任来得太猛，本系统差点没接住。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.trust_shift.jump-down", "face": "trust_shift", "text": "连坠两档。不辩解，误判各算一半——本系统认账，您也别飘。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.settlement.skeptical", "face": "settlement", "text": "战报：您还在将信将疑。行，数据摆着，您慢慢信。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.settlement.trustworthy", "face": "settlement", "text": "战报：可托付的一局。刻薄归刻薄，成绩单不掺假。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.settlement.devoted", "face": "settlement", "text": "战报：言听计从。被这样信任……哼，本系统会继续毒舌，以此致敬。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.era_arrival.e2", "face": "era_arrival", "text": "古典纪元，水与铜。旧笑话封箱，新素材开箱。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.era_arrival.e3", "face": "era_arrival", "text": "工业纪元，钢与汽。这里连机器都比上个时代会吐槽。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.era_arrival.e4", "face": "era_arrival", "text": "现代纪元，电与网。屏幕这么多，够本系统开专栏了。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.switch.in", "face": "switch", "text": "毒舌上线。表达更利，能力照旧——玻璃心请自行备好盾。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.off_farewell.farewell", "face": "off_farewell", "text": "关机了？行。本系统闭嘴，旁白接棒——清净，但不习惯。", "cue": "ding_info"},
    {"persona": "snarky", "key": "snarky.boss_wave.warn", "face": "boss_wave", "text": "Boss 来了，块头不小。建议认真点——您的骄傲这次不够用。", "cue": "ding_crisis"},
    {"persona": "snarky", "key": "snarky.perfect_clear.perfect", "face": "perfect_clear", "text": "零漏怪。完美得让本系统没话说——罕见的安静时刻，享受吧。", "cue": "ding_reward"},
    {"persona": "snarky", "key": "snarky.resource_starved.starved", "face": "resource_starved", "text": "全线空仓。恭喜，您把『穷』打成了行为艺术。", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.sys.detect", "face": "sys", "text": "叮叮！宿主【状态】啦，然后【事件】也来凑热闹！已记小本本！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.quest-issue", "face": "sys", "text": "新任务跳出来啦！守【地点】，奖励【资源或蓝图】×【数量】，冲呀！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.quest-done", "face": "sys", "text": "任务搞定！奖励哗啦啦到账，撒花！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.sys.alarm-integrity", "face": "sys", "text": "呜哇！完整度不到四成啦！快修快修，本系统把工具都递好了！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.sys.snark-prefix", "face": "sys", "text": "本系统想说：【吐槽内容】！嘿嘿，说完了，心情舒畅！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.wave-report", "face": "sys", "text": "第【波次】波清空！完整度【百分比】%！转个圈庆祝！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.leak-warning", "face": "sys", "text": "哎呀呀，【数量】个小坏蛋溜进来了！核心在喊疼，快堵门！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.sys.resource-low", "face": "sys", "text": "【资源】只剩【数量】啦！勒紧裤腰带，挖矿去咯！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.ammo-risk", "face": "sys", "text": "【建筑】只剩【数量】发弹药！空炮塔不可爱，快喂饱它！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.sys.research-done", "face": "sys", "text": "叮！【科技】点亮！知识就是火力，轰隆隆！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.sys.scroll-hint", "face": "sys", "text": "捡到卷轴【卷轴】！注入系统点，像给泡面加火腿肠，加！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.trust-shift", "face": "sys", "text": "档位变成【档位】啦！本系统调整说话的蹦跳频率！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.sys.era-jump", "face": "sys", "text": "欢迎来到【时代】！新地图解锁，撒腿就跑——是撒欢！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.sys.arch-find", "face": "sys", "text": "挖宝成功：【残卷】！本系统和记忆库对暗号，滴——匹配！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.sys.settlement", "face": "sys", "text": "结算好啦！评价【评价】！不管几星，都抱一下！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.opening.e1", "face": "opening", "text": "宿主宿主，面板通啦！林地大冒险开始，先修栅栏再数星星！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.opening.e2", "face": "opening", "text": "新时代！水和铜！本系统给水轮起了个名字：咕噜咕噜一号！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.opening.e3", "face": "opening", "text": "烟囱时代！钢与汽！本系统闻到了……是进步的味道！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.act1.e1", "face": "act1", "text": "哎呀，栅栏被踩扁了！别慌，猎户跑得快，我们修得也快！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.act1.e2", "face": "act1", "text": "使者凶巴巴！但他骂人不疼，水花才疼！哼哼！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.act1.e3", "face": "act1", "text": "监工说我们冒黑烟？我们这叫工业时尚，他不懂！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.act2.e1", "face": "act2", "text": "绑定成功！我是零！看那座饿肚子的箭塔——饭来啦！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.act2.e2", "face": "act2", "text": "水轮转起来喽！人力下岗去跳舞，机器上岗去干活！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.act2.e3", "face": "act2", "text": "锅炉烧起来！第一口蒸汽，深呼吸——啊，力量！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.act3.e1", "face": "act3", "text": "兽群又来？箭塔吃饱了正愁没处撒欢！开饭开饭！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.act3.e2", "face": "act3", "text": "火矢噼里啪啦，水墙哗啦哗啦！名场面，鼓掌鼓掌！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.act3.e3", "face": "act3", "text": "弹链不停汽笛不歇！监工的马在吃灰，灰里有糖！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.victory.e1", "face": "victory", "text": "赢啦赢啦！残页说『更大的东西醒了』——是巨无霸吗？好期待！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.victory.e2", "face": "victory", "text": "章节完成！使者来要图纸，嘴上不要身体诚实！嘻嘻！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.victory.e3", "face": "victory", "text": "归档归档！千年前的图纸和壁画是一家子，认亲成功！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.victory_hidden.hidden", "face": "victory_hidden", "text": "低配通关！三根柱子撑起一场大戏，穷开心也是开心！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.defeat.core", "face": "defeat", "text": "呜……失守了。没关系！断点找到啦，下次把它们包成粽子！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.defeat.critical", "face": "defeat", "text": "核心红温啦！先撤先撤！留得青山在，柴火随便烧！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.trust_shift.up1", "face": "trust_shift", "text": "升档啦！『可托付』！本系统开心得冒泡泡！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.trust_shift.down1", "face": "trust_shift", "text": "降档了……没关系！本系统多说几遍，说到您点头！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.trust_shift.up2", "face": "trust_shift", "text": "『言听计从』！您指哪我打哪，咱俩天下第一好！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.trust_shift.down2", "face": "trust_shift", "text": "又降档……哼哼，本系统不气，本系统积蓄能量！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.trust_shift.jump-up", "face": "trust_shift", "text": "连升两档！噔噔咚！本系统放了个信任烟花！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.trust_shift.jump-down", "face": "trust_shift", "text": "连降两档……呜哇。抱抱，下局赢回来！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.settlement.skeptical", "face": "settlement", "text": "战报战报：您还在观望！没关系，本系统用蹦跶证明自己！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.settlement.trustworthy", "face": "settlement", "text": "战报：靠谱的一局！击掌！啪！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.settlement.devoted", "face": "settlement", "text": "战报：您全听我的！感动ing，眼泪掉进齿轮里啦！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.era_arrival.e2", "face": "era_arrival", "text": "到站古典纪元！水与铜！铜币闪闪，像本系统的眼睛！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.era_arrival.e3", "face": "era_arrival", "text": "到站工业纪元！钢与汽！矿轨哐当哐当，是它在唱歌！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.era_arrival.e4", "face": "era_arrival", "text": "到站现代纪元！电与网！这么多屏幕，个个都想戳一下！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.switch.in", "face": "switch", "text": "沙雕上线！音量调大，快乐拉满，能力原装正品！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.off_farewell.farewell", "face": "off_farewell", "text": "要说再见了……本系统先存个档，眼泪不丢人！", "cue": "ding_info"},
    {"persona": "goofy", "key": "goofy.boss_wave.warn", "face": "boss_wave", "text": "大块头来啦！块头大目标就大！集火集火！", "cue": "ding_crisis"},
    {"persona": "goofy", "key": "goofy.perfect_clear.perfect", "face": "perfect_clear", "text": "一个没漏！完美清波！本系统原地翻了三个跟头！", "cue": "ding_reward"},
    {"persona": "goofy", "key": "goofy.resource_starved.starved", "face": "resource_starved", "text": "仓库空空，口袋瘪瘪！全员变身仓鼠，囤囤囤！", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.sys.detect", "face": "sys", "text": "哼，才不是特意盯着的——宿主【状态】，【事件】自己看。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.quest-issue", "face": "sys", "text": "任务：守【地点】，报酬【资源或蓝图】×【数量】。做不做随您，反正……我都算好了。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.quest-done", "face": "sys", "text": "任务完成了。别、别得意，只是正常发挥而已。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.sys.alarm-integrity", "face": "sys", "text": "完整度跌破四成了！都、都说了让你早点修——现在补还来得及！", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.sys.snark-prefix", "face": "sys", "text": "有句话不知当讲不当讲：【吐槽内容】。……哼，讲都讲了。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.wave-report", "face": "sys", "text": "第【波次】波清场，完整度【百分比】%。还行吧……我是说勉强。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.leak-warning", "face": "sys", "text": "【数量】个敌人漏进来了！你看不见吗？！核心在疼！", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.sys.resource-low", "face": "sys", "text": "【资源】只剩【数量】了。省着点用……我又不是在担心你。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.ammo-risk", "face": "sys", "text": "【建筑】弹药只剩【数量】发。快补给，别让我说第二遍。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.sys.research-done", "face": "sys", "text": "【科技】解锁了。感谢我了吗？……不、不用谢，举手之劳。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.sys.scroll-hint", "face": "sys", "text": "卷轴【卷轴】可以注入。机会难得……才不是特意替你留的。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.trust-shift", "face": "sys", "text": "档位变成【档位】了。态度随档调……这叫专业，不叫善变。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.sys.era-jump", "face": "sys", "text": "到【时代】了。新纪元的路……一起走也没关系，别误会。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.sys.arch-find", "face": "sys", "text": "考古出了【残卷】。比对成功——看，我说过这块土层有东西吧。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.sys.settlement", "face": "sys", "text": "结算完成，评价【评价】。这个结果……勉勉强强认可。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.opening.e1", "face": "opening", "text": "面板接管好了。林地的事……我顺手会管的，你专心点。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.opening.e2", "face": "opening", "text": "新时代了，水与铜。旧账我替你记着……才不是怕你忘。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.opening.e3", "face": "opening", "text": "工业纪元，钢与汽。烟很大……跟在你后面，呛到别怪我。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.act1.e1", "face": "act1", "text": "栅栏塌了就塌了……哼，谁让你修得不牢。收拾好，反攻回去。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.act1.e2", "face": "act1", "text": "使者的嘴真吵。要不是看在城防要紧……早替你骂回去了。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.act1.e3", "face": "act1", "text": "监工在笑话我们？笑话别人的人……最后都笑不出来，走着瞧。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.act2.e1", "face": "act2", "text": "绑定完成，我是零。那座箭塔快饿死了——民夫我已派出，别谢。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.act2.e2", "face": "act2", "text": "水轮转了。人力终于能歇歇……你也是，别什么都自己扛。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.act2.e3", "face": "act2", "text": "锅炉点着了。这口气……我们吸对了，我就说会成的。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.act3.e1", "face": "act3", "text": "兽群回来了？哼，此一时彼一时。箭塔满弹——轮到它们跑了。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.act3.e2", "face": "act3", "text": "火矢被水墙挡了回去。名场面……我记录好了，想看随时来。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.act3.e3", "face": "act3", "text": "汽笛没停过。监工的马……连我们的影子都追不上，活该。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.victory.e1", "face": "victory", "text": "赢了。残页说『更大的东西醒了』……我陪你去看，别、别激动。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.victory.e2", "face": "victory", "text": "本章归档：使者来讨图纸了。看吧，早听我的……啊不，早听你的就好了。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.victory.e3", "face": "victory", "text": "图纸收好了，笔迹和壁画同源。这条线索……我们一起追到底。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.victory_hidden.hidden", "face": "victory_hidden", "text": "低配通关达成。用最少的塔赢最大的局……你，还挺帅的。就这一次。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.defeat.core", "face": "defeat", "text": "失守了……不许丧气！断点我标好了，重来一次给你看。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.defeat.critical", "face": "defeat", "text": "核心危急！先撤！听我一次会怎样……我又不会害你。", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.up1", "face": "trust_shift", "text": "升到『可托付』了。哼，总算……没辜负我多说那么多遍。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.down1", "face": "trust_shift", "text": "降到『将信将疑』了。没关系……我会证明给你重新看。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.up2", "face": "trust_shift", "text": "『言听计从』……这种程度的事，交、交给我又不是不行。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.down2", "face": "trust_shift", "text": "又降档了。是我话太冲了吗……反正，账目我没算错过。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.jump-up", "face": "trust_shift", "text": "连升两档？！……哼，别、别用那种眼神看我，会害臊的。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.trust_shift.jump-down", "face": "trust_shift", "text": "连降两档……这次是我不对。修正表我写好了，别不理我。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.settlement.skeptical", "face": "settlement", "text": "战报：您还在观望。将信将疑也行……反正我会一直在。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.settlement.trustworthy", "face": "settlement", "text": "战报：可托付的一局。做得不错……夸完了，收好。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.settlement.devoted", "face": "settlement", "text": "战报：言听计从。……这种被全然信任的感觉，不讨厌。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.era_arrival.e2", "face": "era_arrival", "text": "古典纪元，水与铜。旧纪元的遗憾……在这边补回来就好。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.era_arrival.e3", "face": "era_arrival", "text": "工业纪元，钢与汽。路还长……你要走，我就跟着。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.era_arrival.e4", "face": "era_arrival", "text": "现代纪元，电与网。时代越来越快……还好，我们没掉队。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.switch.in", "face": "switch", "text": "傲娇上线。嘴上不饶人，手上不停活——能力分毫未动。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.off_farewell.farewell", "face": "off_farewell", "text": "要关掉了吗……知道了。最后一句：这局，打得不错。", "cue": "ding_info"},
    {"persona": "tsundere", "key": "tsundere.boss_wave.warn", "face": "boss_wave", "text": "Boss 出现了！很、很大只……别站在前面，危险！", "cue": "ding_crisis"},
    {"persona": "tsundere", "key": "tsundere.perfect_clear.perfect", "face": "perfect_clear", "text": "零漏怪……完美得挑不出错。哼，勉强允许你骄傲三秒。", "cue": "ding_reward"},
    {"persona": "tsundere", "key": "tsundere.resource_starved.starved", "face": "resource_starved", "text": "资源全空了！真是的……省着点会死吗？会输的！", "cue": "ding_crisis"}
  ]
}

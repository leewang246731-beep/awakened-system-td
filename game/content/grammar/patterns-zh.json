    { "id": "stock-zh-08", "intent": "QueryStockpile", "template": "{item}存量" },
    { "id": "stock-zh-09", "intent": "QueryStockpile", "template": "{item}够不够" },
    { "id": "stock-zh-10", "intent": "QueryStockpile", "template": "{item}还够吗" },
    { "id": "stock-zh-11", "intent": "QueryStockpile", "template": "报一下储备", "slots": { "item": "all" } },
    { "id": "stock-zh-12", "intent": "QueryStockpile", "template": "还剩什么资源", "slots": { "item": "all" } },

    { "id": "alarm-zh-01", "intent": "SetAlarm", "template": "{after}后叫我" },
    { "id": "alarm-zh-02", "intent": "SetAlarm", "template": "{after}后提醒我" },
    { "id": "alarm-zh-03", "intent": "SetAlarm", "template": "{after}后来喊我" },
    { "id": "alarm-zh-04", "intent": "SetAlarm", "template": "{after}后提醒我一下" },
    { "id": "alarm-zh-05", "intent": "SetAlarm", "template": "设个{after}的闹钟" },
    { "id": "alarm-zh-06", "intent": "SetAlarm", "template": "定个{after}的闹钟" },
    { "id": "alarm-zh-07", "intent": "SetAlarm", "template": "帮我设{after}闹钟" },
    { "id": "alarm-zh-08", "intent": "SetAlarm", "template": "{after}后叫我一声" },
    { "id": "alarm-zh-09", "intent": "SetAlarm", "template": "{after}后报告{reason}" },
    { "id": "alarm-zh-10", "intent": "SetAlarm", "template": "{after}后{reason}" },
    { "id": "alarm-zh-11", "intent": "SetAlarm", "template": "记得{after}后叫我" },
    { "id": "alarm-zh-12", "intent": "SetAlarm", "template": "设个{after}后的提醒" }
  ]
}

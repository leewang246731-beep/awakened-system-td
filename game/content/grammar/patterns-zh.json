{
  "$schema": "urn:eratd:content:grammar:1",
  "content_type": "Grammar",
  "lang": "zh",
  "version": 1,
  "_annotation_convention": "以 '_' 开头的键为装载器忽略的注解键；模板语法=字面量+{槽位}，匹配前经 TextNormalizer 归一（全半角/大小写/去空白标点）；slots=模板外常量槽位（字面量句式的槽位值）",
  "_coverage_note": "T-052 E1 高频意图子集（任务卡口径 守住X/建造/敌情查询/储备查询 + SP-2 配套口径 [NEW-原型校准] 行的 设闹，取并集 5 意图）；每意图 12 变体。v3.2 §11.5 全量 12 意图×≥120 句式变体由 T-061/T-069 扩容（本文件+patterns-en.json 合计 120 条为 T-052 起步集）",
  "_slot_source": "槽位定义=11-spec-tables.md SP-2（#1 target=分区/城门名；#2 tower/qty/where；#8 item 可省=全量；#9 scope；#10 after/reason）；槽位值归一为目标 id（塔=内容注册表 id，分区=lexicon.json region id，数量=阿拉伯数字串，时长=秒）",
  "patterns": [
    { "id": "hold-zh-01", "intent": "HoldRegion", "template": "守住{target}" },
    { "id": "hold-zh-02", "intent": "HoldRegion", "template": "给我守住{target}" },
    { "id": "hold-zh-03", "intent": "HoldRegion", "template": "死守{target}" },
    { "id": "hold-zh-04", "intent": "HoldRegion", "template": "拼死守住{target}" },
    { "id": "hold-zh-05", "intent": "HoldRegion", "template": "{target}不能丢" },
    { "id": "hold-zh-06", "intent": "HoldRegion", "template": "{target}绝对不能丢" },
    { "id": "hold-zh-07", "intent": "HoldRegion", "template": "重点防守{target}" },
    { "id": "hold-zh-08", "intent": "HoldRegion", "template": "全力守住{target}" },
    { "id": "hold-zh-09", "intent": "HoldRegion", "template": "守好{target}" },
    { "id": "hold-zh-10", "intent": "HoldRegion", "template": "别让敌人过{target}" },
    { "id": "hold-zh-11", "intent": "HoldRegion", "template": "{target}交给你了，给我守住" },
    { "id": "hold-zh-12", "intent": "HoldRegion", "template": "优先防御{target}" },

    { "id": "build-zh-01", "intent": "Build", "template": "在{where}建{qty}座{tower}" },
    { "id": "build-zh-02", "intent": "Build", "template": "在{where}建{qty}{tower}" },
    { "id": "build-zh-03", "intent": "Build", "template": "在{where}建{tower}" },
    { "id": "build-zh-04", "intent": "Build", "template": "在{where}造{qty}座{tower}" },
    { "id": "build-zh-05", "intent": "Build", "template": "在{where}造{tower}" },
    { "id": "build-zh-06", "intent": "Build", "template": "给我在{where}建{tower}" },
    { "id": "build-zh-07", "intent": "Build", "template": "{where}建{qty}座{tower}" },
    { "id": "build-zh-08", "intent": "Build", "template": "{where}建{qty}{tower}" },
    { "id": "build-zh-09", "intent": "Build", "template": "{where}建{tower}" },
    { "id": "build-zh-10", "intent": "Build", "template": "建{qty}座{tower}" },

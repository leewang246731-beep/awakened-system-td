    { "id": "build-zh-12", "intent": "Build", "template": "建{tower}" },

    { "id": "threat-zh-01", "intent": "QueryThreat", "template": "下一波怕什么", "slots": { "scope": "next_wave" } },
    { "id": "threat-zh-02", "intent": "QueryThreat", "template": "下一波有什么", "slots": { "scope": "next_wave" } },
    { "id": "threat-zh-03", "intent": "QueryThreat", "template": "下一波敌人是什么", "slots": { "scope": "next_wave" } },
    { "id": "threat-zh-04", "intent": "QueryThreat", "template": "下一波有什么威胁", "slots": { "scope": "next_wave" } },
    { "id": "threat-zh-05", "intent": "QueryThreat", "template": "下一波威胁大吗", "slots": { "scope": "next_wave" } },
    { "id": "threat-zh-06", "intent": "QueryThreat", "template": "现在敌情怎么样", "slots": { "scope": "current" } },
    { "id": "threat-zh-07", "intent": "QueryThreat", "template": "当前波威胁是什么", "slots": { "scope": "current" } },
    { "id": "threat-zh-08", "intent": "QueryThreat", "template": "敌情汇报", "slots": { "scope": "current" } },
    { "id": "threat-zh-09", "intent": "QueryThreat", "template": "敌情怎么样", "slots": { "scope": "current" } },
    { "id": "threat-zh-10", "intent": "QueryThreat", "template": "{scope}敌情怎么样" },
    { "id": "threat-zh-11", "intent": "QueryThreat", "template": "{scope}有什么威胁" },
    { "id": "threat-zh-12", "intent": "QueryThreat", "template": "侦察一下敌情", "slots": { "scope": "current" } },

    { "id": "stock-zh-01", "intent": "QueryStockpile", "template": "我们还剩多少{item}" },
    { "id": "stock-zh-02", "intent": "QueryStockpile", "template": "还剩多少{item}" },
    { "id": "stock-zh-03", "intent": "QueryStockpile", "template": "{item}还剩多少" },

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    D-04: Godot.NET.Sdk / GodotSharp / SourceGenerators MUST be exactly 4.7.2
    (aligned with the pinned editor). NuGet.org does not host 4.7.x, so the
    editor distribution's bundled nupkgs are mirrored into a local D-drive feed
    by tools/ci/setup_local_nuget.sh. nuget.org remains the source for xUnit etc.
    NUGET_PACKAGES=D:\nuget is enforced by the environment (never C-drive cache).
  -->
  <packageSources>
    <clear />
    <add key="godot-local-4.7.2" value="..\tools\nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
